<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tic Tac Toe</title>
<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1f1c2c, #928dab);
    font-family: 'Segoe UI', system-ui, sans-serif;
    color: #fff;
    padding: 20px;
  }

  h1 {
    margin-bottom: 4px;
    font-size: 2rem;
    letter-spacing: 2px;
  }

  #status {
    margin-bottom: 20px;
    font-size: 1.2rem;
    min-height: 1.5em;
    text-align: center;
  }

  #board {
    display: grid;
    grid-template-columns: repeat(3, 100px);
    grid-template-rows: repeat(3, 100px);
    gap: 8px;
    background: rgba(255, 255, 255, 0.15);
    padding: 8px;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
  }

  .cell {
    background: rgba(255, 255, 255, 0.9);
    border: none;
    border-radius: 10px;
    font-size: 3rem;
    font-weight: bold;
    color: #1f1c2c;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.15s ease, background 0.2s ease;
    user-select: none;
  }

  .cell:hover:not(.taken) {
    background: #fff;
    transform: scale(1.05);
  }

  .cell.x {
    color: #e74c3c;
  }

  .cell.o {
    color: #2980b9;
  }

  .cell.win {
    background: #2ecc71;
    color: #fff;
  }

  #controls {
    margin-top: 24px;
    display: flex;
    gap: 12px;
  }

  button.action {
    padding: 10px 20px;
    border: none;
    border-radius: 8px;
    background: #fff;
    color: #1f1c2c;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  button.action:hover {
    background: #e0e0e0;
    transform: translateY(-2px);
  }

  #score {
    margin-top: 18px;
    display: flex;
    gap: 20px;
    font-size: 0.95rem;
    opacity: 0.9;
  }

  #modeBar {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .switch {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-size: 0.95rem;
  }

  .switch input {
    width: 18px;
    height: 18px;
    cursor: pointer;
  }

  #levelSelect {
    padding: 6px 10px;
    border-radius: 8px;
    border: none;
    font-size: 0.95rem;
    font-weight: 600;
    color: #1f1c2c;
    cursor: pointer;
    background: #fff;
  }

  #levelSelect.hidden {
    display: none;
  }

  .cell.thinking {
    cursor: not-allowed;
  }
</style>
</head>
<body>

  <h1>Tic Tac Toe</h1>

  <div id="modeBar">
    <label class="switch">
      <input type="checkbox" id="vsAiToggle">
      <span>Gegen KI spielen</span>
    </label>
    <select id="levelSelect" class="hidden">
      <option value="easy">Leicht</option>
      <option value="medium" selected>Mittel</option>
      <option value="hard">Schwer</option>
    </select>
  </div>

  <div id="status">Spieler X ist am Zug</div>

  <div id="board"></div>

  <div id="controls">
    <button class="action" id="resetBtn">Neues Spiel</button>
    <button class="action" id="resetScoreBtn">Punkte zurücksetzen</button>
  </div>

  <div id="score">
    <span>X: <span id="scoreX">0</span></span>
    <span>O: <span id="scoreO">0</span></span>
    <span>Unentschieden: <span id="scoreDraw">0</span></span>
  </div>

<script>
  const boardEl = document.getElementById('board');
  const statusEl = document.getElementById('status');
  const resetBtn = document.getElementById('resetBtn');
  const resetScoreBtn = document.getElementById('resetScoreBtn');
  const scoreXEl = document.getElementById('scoreX');
  const scoreOEl = document.getElementById('scoreO');
  const scoreDrawEl = document.getElementById('scoreDraw');
  const vsAiToggle = document.getElementById('vsAiToggle');
  const levelSelect = document.getElementById('levelSelect');

  let board = Array(9).fill(null);
  let currentPlayer = 'X';
  let gameOver = false;
  let scores = { X: 0, O: 0, Draw: 0 };
  let vsAi = false;
  let aiThinking = false;
  const HUMAN = 'X';
  const AI = 'O';

  const winPatterns = [
    [0,1,2], [3,4,5], [6,7,8], // Reihen
    [0,3,6], [1,4,7], [2,5,8], // Spalten
    [0,4,8], [2,4,6]           // Diagonalen
  ];

  function createBoard() {
    boardEl.innerHTML = '';
    board.forEach((value, index) => {
      const cell = document.createElement('button');
      cell.classList.add('cell');
      cell.dataset.index = index;
      cell.textContent = value ? value : '';
      if (value) cell.classList.add('taken', value.toLowerCase());

      cell.addEventListener('click', () => handleMove(index));

      cell.addEventListener('touchend', (e) => {
        e.preventDefault();
        handleMove(index);
      });

      cell.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          handleMove(index);
        }
      });

      boardEl.appendChild(cell);
    });
  }

  function handleMove(index) {
    if (gameOver || board[index] || aiThinking) return;
    if (vsAi && currentPlayer === AI) return; // KI ist dran, kein Klick erlaubt

    board[index] = currentPlayer;
    checkResult();
    createBoard();

    if (!gameOver) {
      currentPlayer = currentPlayer === 'X' ? 'O' : 'X';
      updateStatusText();

      if (vsAi && currentPlayer === AI) {
        aiThinking = true;
        statusEl.textContent = 'KI denkt nach...';
        setTimeout(aiMove, 450);
      }
    }
  }

  function updateStatusText() {
    if (vsAi) {
      statusEl.textContent = currentPlayer === HUMAN ? 'Du bist am Zug' : 'KI ist am Zug';
    } else {
      statusEl.textContent = `Spieler ${currentPlayer} ist am Zug`;
    }
  }

  function aiMove() {
    if (gameOver) { aiThinking = false; return; }

    const level = levelSelect.value;
    let index;

    if (level === 'easy') {
      index = getRandomMove();
    } else if (level === 'medium') {
      // 50% klug, 50% zufällig
      index = Math.random() < 0.5 ? getBestMove() : getRandomMove();
    } else {
      index = getBestMove();
    }

    if (index !== null && index !== undefined) {
      board[index] = AI;
      checkResult();
      createBoard();

      if (!gameOver) {
        currentPlayer = HUMAN;
        updateStatusText();
      }
    }
    aiThinking = false;
  }

  function getRandomMove() {
    const empty = board.map((v, i) => v === null ? i : null).filter(v => v !== null);
    return empty[Math.floor(Math.random() * empty.length)];
  }

  function getBestMove() {
    let bestScore = -Infinity;
    let move = null;
    for (let i = 0; i < 9; i++) {
      if (board[i] === null) {
        board[i] = AI;
        const score = minimax(board, 0, false);
        board[i] = null;
        if (score > bestScore) {
          bestScore = score;
          move = i;
        }
      }
    }
    return move;
  }

  function minimax(b, depth, isMaximizing) {
    const winner = getWinner(b);
    if (winner === AI) return 10 - depth;
    if (winner === HUMAN) return depth - 10;
    if (b.every(cell => cell !== null)) return 0;

    if (isMaximizing) {
      let best = -Infinity;
      for (let i = 0; i < 9; i++) {
        if (b[i] === null) {
          b[i] = AI;
          best = Math.max(best, minimax(b, depth + 1, false));
          b[i] = null;
        }
      }
      return best;
    } else {
      let best = Infinity;
      for (let i = 0; i < 9; i++) {
        if (b[i] === null) {
          b[i] = HUMAN;
          best = Math.min(best, minimax(b, depth + 1, true));
          b[i] = null;
        }
      }
      return best;
    }
  }

  function getWinner(b) {
    for (const pattern of winPatterns) {
      const [a, x, c] = pattern;
      if (b[a] && b[a] === b[x] && b[a] === b[c]) return b[a];
    }
    return null;
  }

  function checkResult() {
    for (const pattern of winPatterns) {
      const [a, b, c] = pattern;
      if (board[a] && board[a] === board[b] && board[a] === board[c]) {
        gameOver = true;
        statusEl.textContent = `Spieler ${board[a]} gewinnt! 🎉`;
        highlightWin(pattern);
        scores[board[a]]++;
        updateScore();
        return;
      }
    }

    if (board.every(cell => cell !== null)) {
      gameOver = true;
      statusEl.textContent = 'Unentschieden!';
      scores.Draw++;
      updateScore();
    }
  }

  function highlightWin(pattern) {
    setTimeout(() => {
      pattern.forEach(i => {
        const cell = boardEl.children[i];
        cell.classList.add('win');
      });
    }, 0);
  }

  function updateScore() {
    scoreXEl.textContent = scores.X;
    scoreOEl.textContent = scores.O;
    scoreDrawEl.textContent = scores.Draw;
  }

  function resetGame() {
    board = Array(9).fill(null);
    currentPlayer = 'X';
    gameOver = false;
    aiThinking = false;
    updateStatusText();
    createBoard();
  }

  resetBtn.addEventListener('click', resetGame);
  resetScoreBtn.addEventListener('click', () => {
    scores = { X: 0, O: 0, Draw: 0 };
    updateScore();
  });

  vsAiToggle.addEventListener('change', () => {
    vsAi = vsAiToggle.checked;
    levelSelect.classList.toggle('hidden', !vsAi);
    resetGame();
  });

  levelSelect.addEventListener('change', resetGame);
  levelSelect.classList.toggle('hidden', !vsAi);

  createBoard();
</script>

</body>
</html>
